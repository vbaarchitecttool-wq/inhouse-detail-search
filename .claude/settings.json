{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node .claude/hooks/guard-generated.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node .claude/hooks/validate-commentary.mjs"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node .claude/hooks/typecheck.mjs",
            "timeout": 120
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "node .claude/hooks/trigger-ui-skills.mjs"
          }
        ]
      }
    ]
  }
}
